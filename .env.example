# Database
ConnectionStrings__DefaultConnection=Server=your-server;Database=your-db;User Id=your-user;Password=your-password;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

# Auth  
Authentication__Google__ClientId=your-google-client-id
Authentication__Google__ClientSecret=your-google-client-secret

# Zoom
Zoom__AccountId=your-zoom-account-id
Zoom__ClientId=your-zoom-client-id
Zoom__ClientSecret=your-zoom-client-secret
Zoom__MeetingSdkClientId=your-zoom-sdk-client-id
Zoom__MeetingSdkClientSecret=your-zoom-sdk-client-secret

# Email (SendGrid)
Email__Password=your-sendgrid-api-key
Email__FromAddress=noreply@yourdomain.com

# Resend (fallback)
Resend__ApiKey=your-resend-api-key

# Twilio (SMS / WhatsApp)
Twilio__AccountSid=your-twilio-sid
Twilio__AuthToken=your-twilio-token
Twilio__FromNumber=+1234567890

# Paymob
Paymob__ApiKey=your-paymob-api-key
Paymob__IntegrationId=your-integration-id
Paymob__IframeId=your-iframe-id
Paymob__HmacSecret=your-hmac-secret

# Fawry
Fawry__MerchantCode=your-merchant-code
Fawry__SecurityKey=your-security-key

# Frontend URL
Frontend__Url=https://your-frontend-domain.com

# ASP.NET
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
